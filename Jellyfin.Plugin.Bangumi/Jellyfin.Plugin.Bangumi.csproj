<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Bangumi</RootNamespace>
    <BangumiWebDirectory>$(MSBuildProjectDirectory)/../web</BangumiWebDirectory>
    <BangumiWebBundle>$(BangumiWebDirectory)/dist/bangumi.js</BangumiWebBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AnitomySharp.NET6"/>
    <PackageReference Include="Fastenshtein"/>
    <PackageReference Include="FuzzySharp"/>
    <PackageReference Include="Jellyfin.Controller" IncludeAssets="compile"/>
    <PackageReference Include="Newtonsoft.Json" IncludeAssets="compile"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(BangumiWebDirectory)/pages/configuration.html" LogicalName="Jellyfin.Plugin.Bangumi.Configuration.Main.html"/>
    <EmbeddedResource Include="$(BangumiWebDirectory)/pages/development.js" LogicalName="Jellyfin.Plugin.Bangumi.Configuration.Development.js"/>
    <EmbeddedResource Include="$(BangumiWebBundle)" LogicalName="Jellyfin.Plugin.Bangumi.Configuration.Main.js"/>
    <EmbeddedResource Include="$(BangumiWebDirectory)/pages/duplicates.html" LogicalName="Jellyfin.Plugin.Bangumi.Tools.DuplicatedEpisodesDetector.Index.html"/>
    <EmbeddedResource Include="$(BangumiWebDirectory)/pages/fix-metadata.html" LogicalName="Jellyfin.Plugin.Bangumi.Tools.FixEpisodeMetadata.Index.html"/>
    <EmbeddedResource Include="$(BangumiWebDirectory)/pages/missing-id.html" LogicalName="Jellyfin.Plugin.Bangumi.Tools.MissingBangumiId.Index.html"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Bangumi.Test"/>
  </ItemGroup>
  <Target Name="BuildBangumiWeb" BeforeTargets="PrepareForBuild" Condition="'$(SkipWebBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(BangumiWebSource)" Outputs="$(BangumiWebBundle)">
    <Exec WorkingDirectory="$(BangumiWebDirectory)" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(BangumiWebDirectory)" Command="npm run build" />
  </Target>
  <Target Name="ValidateBangumiWebBundle" BeforeTargets="PrepareResourceNames" DependsOnTargets="BuildBangumiWeb"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(BangumiWebBundle)')"
           Text="Bangumi web bundle is missing. Run npm ci and npm run build in web/, or build without -p:SkipWebBuild=true." />
  </Target>
  <ItemGroup>
    <BangumiWebSource Include="../web/src/**/*;../web/package.json;../web/package-lock.json;../web/vite.config.ts;../web/tsconfig.json" />
  </ItemGroup>
</Project>
